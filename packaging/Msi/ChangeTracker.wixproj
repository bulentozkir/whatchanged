<Project Sdk="WixToolset.Sdk/5.0.2">
  <PropertyGroup>
    <InstallerPlatform Condition="'$(InstallerPlatform)' == ''">x64</InstallerPlatform>
    <OutputName>ChangeTracker-$(Version)-$(InstallerPlatform)</OutputName>
    <DefineConstants>$(DefineConstants);ProductVersion=$(Version)</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <BindPath Include="$(PublishDirectory)" BindName="Publish" />
  </ItemGroup>
  <Target Name="ValidatePublishDirectory" BeforeTargets="BeforeBuild">
    <Error Condition="!Exists('$(PublishDirectory)\PCChangeTracker.exe')" Text="PublishDirectory must contain the self-contained $(InstallerPlatform) application." />
  </Target>
</Project>