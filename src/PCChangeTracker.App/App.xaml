<Application x:Class="PCChangeTracker.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="clr-namespace:System;assembly=System.Runtime"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <!-- Design system: color tokens first, then control styles that reference them. Appearance swaps token values at run time. -->
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Colors.xaml" />
                <ResourceDictionary Source="Themes/Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolVisibility" />
            <DataTemplate DataType="{x:Type sys:String}"><TextBlock Text="{Binding}" TextWrapping="Wrap"/></DataTemplate>
            <!-- Type ramp; Appearance.ApplyTextSize rescales these for the Text size setting. Body text is AppFont15. -->
            <FontFamily x:Key="AppFontFamily">Segoe UI</FontFamily>
            <sys:Double x:Key="AppFont14">14</sys:Double>
            <sys:Double x:Key="AppFont15">15</sys:Double>
            <sys:Double x:Key="AppFont16">16</sys:Double>
            <sys:Double x:Key="AppFont17">17</sys:Double>
            <sys:Double x:Key="AppFont18">18</sys:Double>
            <sys:Double x:Key="AppFont19">19</sys:Double>
            <sys:Double x:Key="AppFont20">20</sys:Double>
            <sys:Double x:Key="AppFont22">22</sys:Double>
            <sys:Double x:Key="AppFont24">24</sys:Double>
            <sys:Double x:Key="AppFont26">26</sys:Double>
            <GridLength x:Key="SidebarWidth">216</GridLength>
        </ResourceDictionary>
    </Application.Resources>
</Application>
