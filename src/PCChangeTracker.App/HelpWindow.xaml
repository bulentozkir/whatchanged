<Window x:Class="PCChangeTracker.App.HelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:PCChangeTracker.App.Localization"
        xmlns:controls="clr-namespace:PCChangeTracker.App.Controls"
        Title="{loc:Loc HelpTitle}" Width="1040" Height="760" MinWidth="720" MinHeight="520"
        WindowStartupLocation="CenterOwner" Language="{Binding Texts.XmlLanguage}" Style="{StaticResource {x:Type Window}}">
    <!-- Find focuses the topic search; its Ctrl+F gesture is handled in OnPreviewKeyDown so it also works from the document. -->
    <Window.CommandBindings>
        <CommandBinding Command="ApplicationCommands.Find" Executed="FocusSearch"/>
    </Window.CommandBindings>
    <Grid Margin="20,14,20,16" FlowDirection="{Binding Texts.Direction}">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <!-- One header row: title, document text size, and Close. Search sits with the topics it filters. -->
        <DockPanel Margin="0,0,0,12">
            <Button DockPanel.Dock="Right" Content="{loc:Loc Close}" IsCancel="True" Click="CloseHelp" Margin="0" VerticalAlignment="Center" controls:Icon.Glyph="&#xE711;"
                    AutomationProperties.AutomationId="CloseHelp"/>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,20,0">
                <Label Content="{loc:Loc TextSize}" Target="{Binding ElementName=TextZoom}" Style="{StaticResource InlineLabel}"/>
                <Slider x:Name="TextZoom" Minimum="100" Maximum="160" Value="100" TickFrequency="10" IsSnapToTickEnabled="True" Width="120" VerticalAlignment="Center"
                        AutomationProperties.Name="{loc:Loc TextSize}" AutomationProperties.AutomationId="HelpTextSize" ValueChanged="TextSizeChanged"/>
                <TextBlock Text="{Binding ElementName=TextZoom, Path=Value, StringFormat={}{0:0}%}" MinWidth="44" Margin="8,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{loc:Loc HelpHeading}" FontSize="{DynamicResource AppFont22}" FontWeight="SemiBold" AutomationProperties.HeadingLevel="Level1"/>
                <TextBlock Text="{loc:Loc OfflineGuide}" Style="{StaticResource PageSubtitle}"/>
            </StackPanel>
        </DockPanel>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="240"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Grid Margin="0,0,16,0">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <Label Content="{loc:Loc SearchHelp}" Target="{Binding ElementName=HelpSearch}"/>
                <TextBox x:Name="HelpSearch" Grid.Row="1" TextChanged="SearchChanged" MaxLength="160" AutomationProperties.Name="{loc:Loc SearchHelp}" AutomationProperties.AutomationId="HelpSearch"/>
                <TextBlock x:Name="SearchStatus" Grid.Row="2" Style="{StaticResource HelpText}" FontWeight="SemiBold" Margin="0,8,0,6" AutomationProperties.LiveSetting="Polite"/>
                <ListBox x:Name="TopicList" Grid.Row="3" SelectionChanged="TopicChanged" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         AutomationProperties.Name="{loc:Loc HelpHeading}" AutomationProperties.AutomationId="HelpTopics">
                    <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}"><Setter Property="AutomationProperties.Name" Value="{Binding Title}"/></Style></ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Title}"/></DataTemplate></ListBox.ItemTemplate>
                </ListBox>
            </Grid>
            <Border Grid.Column="1" BorderBrush="{DynamicResource CardStrokeBrush}" BorderThickness="1" CornerRadius="8" Padding="1" Background="{DynamicResource SurfaceBrush}">
                <FlowDocumentScrollViewer x:Name="HelpReader" IsToolBarVisible="False" VerticalScrollBarVisibility="Auto"
                                          Background="{DynamicResource SurfaceBrush}" Zoom="{Binding ElementName=TextZoom, Path=Value}" MinZoom="100" MaxZoom="160"
                                          SizeChanged="ReaderSizeChanged"
                                          AutomationProperties.Name="{loc:Loc HelpHeading}" AutomationProperties.AutomationId="HelpContent"/>
            </Border>
        </Grid>
    </Grid>
</Window>
