<Window x:Class="PCChangeTracker.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:PCChangeTracker.App.Localization"
        Title="ChangeTracker" Width="1240" Height="820" MinWidth="900" MinHeight="620" WindowState="Maximized" ShowInTaskbar="True"
        WindowStartupLocation="CenterScreen" Language="{Binding Texts.XmlLanguage}" Style="{StaticResource {x:Type Window}}">
    <Window.CommandBindings>
        <CommandBinding Command="ApplicationCommands.Help" Executed="OpenHelp"/>
    </Window.CommandBindings>
    <Window.InputBindings>
        <KeyBinding Key="F1" Command="ApplicationCommands.Help"/>
    </Window.InputBindings>
    <Window.Resources>
        <loc:SnapshotTextConverter x:Key="SnapshotText"/>
        <Style x:Key="ReviewPage" TargetType="FrameworkElement">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers><DataTrigger Binding="{Binding Page}" Value="Review"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
        </Style>
        <Style x:Key="HistoryPage" TargetType="FrameworkElement">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers><DataTrigger Binding="{Binding Page}" Value="History"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
        </Style>
        <Style x:Key="SourcesPage" TargetType="FrameworkElement">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers><DataTrigger Binding="{Binding Page}" Value="Sources"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
        </Style>
        <Style x:Key="SettingsPage" TargetType="FrameworkElement">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers><DataTrigger Binding="{Binding Page}" Value="Settings"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
        </Style>
        <DataTemplate x:Key="SnapshotChoiceTemplate">
            <StackPanel MaxWidth="520">
                <TextBlock FontWeight="SemiBold" FontSize="{DynamicResource AppFont16}" Visibility="{Binding DataContext.Simple, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolVisibility}}">
                    <TextBlock.Text><MultiBinding Converter="{StaticResource SnapshotText}" ConverterParameter="Date"><Binding/><Binding Path="DataContext.Texts" RelativeSource="{RelativeSource AncestorType=Window}"/><Binding Path="DataContext.Texts.Revision" RelativeSource="{RelativeSource AncestorType=Window}"/></MultiBinding></TextBlock.Text>
                </TextBlock>
                <TextBlock FontWeight="SemiBold" FontSize="{DynamicResource AppFont16}" FlowDirection="LeftToRight">
                    <TextBlock.Text><MultiBinding Converter="{StaticResource SnapshotText}" ConverterParameter="Time"><Binding/><Binding Path="DataContext.Texts" RelativeSource="{RelativeSource AncestorType=Window}"/><Binding Path="DataContext.Texts.Revision" RelativeSource="{RelativeSource AncestorType=Window}"/></MultiBinding></TextBlock.Text>
                </TextBlock>
                <TextBlock FontSize="{DynamicResource AppFont14}" Margin="0,3,0,0">
                    <TextBlock.Text><MultiBinding Converter="{StaticResource SnapshotText}" ConverterParameter="Label"><Binding/><Binding Path="DataContext.Texts" RelativeSource="{RelativeSource AncestorType=Window}"/><Binding Path="DataContext.Texts.Revision" RelativeSource="{RelativeSource AncestorType=Window}"/></MultiBinding></TextBlock.Text>
                </TextBlock>
                <TextBlock FontSize="{DynamicResource AppFont14}">
                    <TextBlock.Text><MultiBinding Converter="{StaticResource SnapshotText}" ConverterParameter="Context"><Binding/><Binding Path="DataContext.Texts" RelativeSource="{RelativeSource AncestorType=Window}"/><Binding Path="DataContext.Texts.Revision" RelativeSource="{RelativeSource AncestorType=Window}"/></MultiBinding></TextBlock.Text>
                </TextBlock>
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="SnapshotDayTemplate">
            <TextBlock FontSize="{DynamicResource AppFont16}"><TextBlock.Text><MultiBinding Converter="{StaticResource SnapshotText}"><Binding/><Binding Path="DataContext.Texts" RelativeSource="{RelativeSource AncestorType=Window}"/><Binding Path="DataContext.Texts.Revision" RelativeSource="{RelativeSource AncestorType=Window}"/></MultiBinding></TextBlock.Text></TextBlock>
        </DataTemplate>
        <Style x:Key="SnapshotDayStyle" TargetType="ComboBoxItem" BasedOn="{StaticResource {x:Type ComboBoxItem}}">
            <Setter Property="AutomationProperties.Name"><Setter.Value><MultiBinding Converter="{StaticResource SnapshotText}"><Binding/><Binding Path="DataContext.Texts" RelativeSource="{RelativeSource AncestorType=Window}"/><Binding Path="DataContext.Texts.Revision" RelativeSource="{RelativeSource AncestorType=Window}"/></MultiBinding></Setter.Value></Setter>
        </Style>
        <Style x:Key="SettingsChoiceStyle" TargetType="ComboBoxItem" BasedOn="{StaticResource {x:Type ComboBoxItem}}">
            <Setter Property="AutomationProperties.Name" Value="{Binding Display}"/>
        </Style>
        <DataTemplate x:Key="ColorChoiceTemplate">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border Width="18" Height="18" Margin="0,0,10,0" Background="{Binding Swatch}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="{Binding Display}" VerticalAlignment="Center"/>
            </Grid>
        </DataTemplate>
        <Style x:Key="SnapshotChoiceStyle" TargetType="ComboBoxItem" BasedOn="{StaticResource {x:Type ComboBoxItem}}">
            <Setter Property="AutomationProperties.Name"><Setter.Value><MultiBinding Converter="{StaticResource SnapshotText}" ConverterParameter="Compact"><Binding/><Binding Path="DataContext.Texts" RelativeSource="{RelativeSource AncestorType=Window}"/><Binding Path="DataContext.Texts.Revision" RelativeSource="{RelativeSource AncestorType=Window}"/></MultiBinding></Setter.Value></Setter>
        </Style>
        <DataTemplate x:Key="DetailRowTemplate">
            <StackPanel Margin="0,8,0,16">
                <WrapPanel Margin="0,0,0,8">
                    <TextBlock Text="{Binding Field}" FontSize="{DynamicResource AppFont18}" FontWeight="SemiBold" Margin="0,0,12,0" AutomationProperties.HeadingLevel="Level4"/>
                    <TextBlock Text="{Binding Difference}" Foreground="{DynamicResource MutedBrush}"/>
                </WrapPanel>
                <UniformGrid Columns="2" SizeChanged="ResponsiveColumnsChanged">
                <StackPanel Margin="0,0,10,8">
                    <TextBlock Text="{loc:Loc Before}" FontWeight="SemiBold" Margin="0,0,0,5"/>
                    <TextBox Text="{Binding Before, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" MinHeight="46" Padding="10"
                             FlowDirection="LeftToRight" FontSize="{DynamicResource AppFont18}" AutomationProperties.Name="{Binding BeforeLabel}"/>
                </StackPanel>
                <StackPanel Margin="0,0,10,8">
                    <TextBlock Text="{loc:Loc After}" FontWeight="SemiBold" Margin="0,0,0,5"/>
                    <TextBox Text="{Binding After, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" MinHeight="46" Padding="10"
                             FlowDirection="LeftToRight" FontSize="{DynamicResource AppFont18}" AutomationProperties.Name="{Binding AfterLabel}"/>
                </StackPanel>
                </UniformGrid>
            </StackPanel>
        </DataTemplate>
        <Style x:Key="SimpleSummaryStyle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontSize" Value="{DynamicResource AppFont18}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Style.Triggers><DataTrigger Binding="{Binding SimpleSummary}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers>
        </Style>
        <Style x:Key="ChangeItemContainerStyle" TargetType="ContentPresenter">
            <Setter Property="AutomationProperties.Name" Value="{Binding TechnicalSummary}"/>
        </Style>
        <Style x:Key="DetailItemContainerStyle" TargetType="ContentPresenter">
            <Setter Property="AutomationProperties.Name" Value="{Binding Field}"/>
        </Style>
        <DataTemplate x:Key="ChangeTemplate">
            <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="6" Padding="18" Margin="0,0,0,12">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <DockPanel LastChildFill="True">
                        <TextBlock DockPanel.Dock="Right" Text="{Binding Priority}" Foreground="{DynamicResource ReviewBrush}" FontWeight="SemiBold" Margin="12,0,0,0"/>
                        <WrapPanel><TextBlock Text="{Binding Category}" Foreground="{DynamicResource MutedBrush}" Margin="0,0,12,0"/><TextBlock Text="{Binding Kind}" FontWeight="Bold"/></WrapPanel>
                    </DockPanel>
                    <TextBlock Grid.Row="1" Text="{Binding Name}" FontSize="{DynamicResource AppFont20}" FontWeight="SemiBold" Margin="0,6,0,8" AutomationProperties.HeadingLevel="Level3"/>
                    <StackPanel Grid.Row="2">
                        <TextBlock Text="{Binding DifferenceSummary}" FontWeight="SemiBold" Margin="0,0,0,10"
                                   Visibility="{Binding DataContext.Advanced, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolVisibility}}"/>
                        <StackPanel Visibility="{Binding DataContext.Simple, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolVisibility}}">
                            <TextBlock Text="{Binding SimpleSummary}" Style="{StaticResource SimpleSummaryStyle}"/>
                            <ItemsControl ItemsSource="{Binding ChangedFields}" ItemTemplate="{StaticResource DetailRowTemplate}" ItemContainerStyle="{StaticResource DetailItemContainerStyle}" AutomationProperties.AutomationId="SimpleChangeValues" AutomationProperties.Name="{loc:Loc BeforeAfter}"/>
                        </StackPanel>
                    </StackPanel>
                    <TextBlock Grid.Row="3" Text="{Binding Why}" FontSize="{DynamicResource AppFont16}" Margin="0,0,0,16"/>
                    <TextBlock Grid.Row="4" Text="{Binding TechnicalSummary}" FontSize="{DynamicResource AppFont14}" Margin="0,0,0,12"
                               Visibility="{Binding DataContext.Advanced, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolVisibility}}"/>
                    <WrapPanel Grid.Row="5">
                        <Button Content="{loc:Loc BeforeAfter}" Command="{Binding DataContext.InspectCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" ToolTip="{loc:Loc BeforeAfter}" Click="RememberDetailOrigin" AutomationProperties.AutomationId="InspectChange"/>
                        <Button Content="{loc:Loc OpenSettings}" Command="{Binding DataContext.OpenSettingsCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" ToolTip="{loc:Loc OpenSettings}"/>
                        <Button Content="{Binding ExpectedAction}" Command="{Binding DataContext.ToggleExpectedCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" ToolTip="{loc:Loc MarkExpected}"/>
                    </WrapPanel>
                    <StackPanel Grid.Row="6" Margin="0,14,0,0" Visibility="{Binding DataContext.Advanced, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolVisibility}}">
                        <Expander Header="{loc:Loc AllFields}" IsExpanded="True" AutomationProperties.AutomationId="AdvancedFields">
                            <StackPanel Margin="0,12,0,0">
                                <ItemsControl ItemsSource="{Binding FieldDetails}" ItemTemplate="{StaticResource DetailRowTemplate}" ItemContainerStyle="{StaticResource DetailItemContainerStyle}" AutomationProperties.Name="{loc:Loc AllFields}"/>
                                <TextBlock Text="{Binding HiddenComparison}" FontWeight="SemiBold" Margin="0,8,0,12"/>
                            </StackPanel>
                        </Expander>
                        <Expander Header="{loc:Loc ObservationMetadata}" Margin="0,10,0,12" AutomationProperties.AutomationId="AdvancedObservationMetadata">
                            <ItemsControl ItemsSource="{Binding ObservationDetails}" ItemTemplate="{StaticResource DetailRowTemplate}" ItemContainerStyle="{StaticResource DetailItemContainerStyle}" Margin="0,10,0,0" AutomationProperties.Name="{loc:Loc ObservationMetadata}"/>
                        </Expander>
                        <TextBlock Text="{loc:Loc AdvancedPrivacy}" FontSize="{DynamicResource AppFont14}" Foreground="{DynamicResource MutedBrush}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid.ColumnDefinitions><ColumnDefinition Width="232"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border Grid.RowSpan="2" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,1,0" Padding="16,22,12,16">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
            <Grid IsEnabled="{Binding BackgroundInteractive}" MinHeight="{Binding ViewportHeight, RelativeSource={RelativeSource AncestorType=ScrollViewer}}">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <StackPanel Margin="0,0,0,24">
                    <TextBlock Text="&#xE9D9;" FontFamily="Segoe MDL2 Assets" FontSize="27" Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,12"/>
                    <TextBlock Text="ChangeTracker" FontSize="{DynamicResource AppFont20}" FontWeight="SemiBold"/>
                </StackPanel>
                <StackPanel Grid.Row="2" FlowDirection="{Binding Texts.Direction}" KeyboardNavigation.TabIndex="1">
                    <TextBlock Text="{Binding SnapshotStorageLabel}" FontSize="{DynamicResource AppFont16}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,18"
                               Focusable="{Binding BackgroundInteractive}" FocusVisualStyle="{StaticResource KeyboardFocus}"
                               AutomationProperties.AutomationId="SnapshotStorage" AutomationProperties.Name="{Binding SnapshotStorageLabel}"
                               AutomationProperties.HelpText="{loc:Loc SnapshotStorageHelp}" ToolTipService.ShowDuration="30000">
                        <TextBlock.ToolTip>
                            <ToolTip DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}" FontFamily="{DynamicResource AppFontFamily}" FontSize="{DynamicResource AppFont14}"
                                     Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource TextBrush}" BorderBrush="{DynamicResource LineBrush}" Padding="12">
                                <TextBlock Text="{Binding Texts[SnapshotStorageHelp]}" MaxWidth="340" TextWrapping="Wrap"/>
                            </ToolTip>
                        </TextBlock.ToolTip>
                    </TextBlock>
                    <Button Content="{loc:Loc Help}" Command="ApplicationCommands.Help" Margin="0,0,0,14" AutomationProperties.AutomationId="HelpMe" ToolTip="F1"/>
                    <TextBlock Text="{loc:Loc LocalReadOnly}" FontSize="{DynamicResource AppFont14}" Foreground="{DynamicResource MutedBrush}"/>
                    <TextBlock Text="{loc:Loc Preview}" FontSize="{DynamicResource AppFont14}" Foreground="{DynamicResource MutedBrush}" Margin="0,5,0,0"/>
                </StackPanel>
                <ListBox x:Name="PageNavigation" SelectedValue="{Binding Page}" SelectedValuePath="Tag" SelectionMode="Single"
                         Grid.Row="1" VerticalAlignment="Top" KeyboardNavigation.TabIndex="0"
                         BorderThickness="0" Padding="3" IsEnabled="{Binding BackgroundInteractive}" FlowDirection="{Binding Texts.Direction}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="{loc:Loc Navigation}" AutomationProperties.AutomationId="PageNavigation">
                    <ListBoxItem Tag="Review" Margin="0,0,0,10" AutomationProperties.AutomationId="ReviewPage" AutomationProperties.Name="{loc:Loc NavReview}"><TextBlock Text="{loc:Loc NavReview}"/></ListBoxItem>
                    <ListBoxItem Tag="History" Margin="0,0,0,10" AutomationProperties.AutomationId="HistoryPage" AutomationProperties.Name="{loc:Loc NavHistory}"><TextBlock Text="{loc:Loc NavHistory}"/></ListBoxItem>
                    <ListBoxItem Tag="Sources" Margin="0,0,0,10" AutomationProperties.AutomationId="SourcesPage" AutomationProperties.Name="{loc:Loc NavSources}"><TextBlock Text="{loc:Loc NavSources}"/></ListBoxItem>
                    <ListBoxItem Tag="Settings" Margin="0,0,0,10" AutomationProperties.AutomationId="SettingsPage" AutomationProperties.Name="{loc:Loc NavSettings}"><TextBlock Text="{loc:Loc NavSettings}"/></ListBoxItem>
                </ListBox>
            </Grid>
            </ScrollViewer>
        </Border>
        <ScrollViewer x:Name="MainContentScroll" Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" IsEnabled="{Binding BackgroundInteractive}" Focusable="False">
        <Grid Margin="24,24,24,16" FlowDirection="{Binding Texts.Direction}">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <WrapPanel x:Name="MainToolbar" Margin="0,0,0,18" AutomationProperties.Name="{loc:Loc Tagline}" KeyboardNavigation.TabNavigation="Continue">
                <WrapPanel VerticalAlignment="Center">
                    <TextBlock Text="{loc:Loc Tagline}" FontWeight="SemiBold" FontSize="{DynamicResource AppFont16}" VerticalAlignment="Center" Margin="0,0,20,0"/>
                    <WrapPanel>
                        <RadioButton Content="{loc:Loc Simple}" GroupName="Mode" IsChecked="{Binding Simple}" AutomationProperties.AutomationId="SimpleMode" ToolTip="{loc:Loc SimpleHelp}" AutomationProperties.HelpText="{loc:Loc SimpleHelp}"/>
                        <RadioButton Content="{loc:Loc Advanced}" GroupName="Mode" IsChecked="{Binding Advanced}" AutomationProperties.AutomationId="AdvancedMode" ToolTip="{loc:Loc AdvancedHelp}" AutomationProperties.HelpText="{loc:Loc AdvancedHelp}"/>
                    </WrapPanel>
                </WrapPanel>
                <WrapPanel Margin="0,6,0,0">
                    <Button Command="{Binding PreviewReportCommand}" IsEnabled="{Binding HasSnapshot}" ToolTip="{loc:Loc ReportPreview}" AutomationProperties.Name="{loc:Loc Report}" AutomationProperties.AutomationId="Report">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE74E;" FontFamily="Segoe MDL2 Assets" Margin="0,2,8,0"/><TextBlock Text="{loc:Loc Report}"/></StackPanel>
                    </Button>
                    <Button x:Name="CheckNowButton" Command="{Binding CaptureCommand}" Style="{StaticResource PrimaryButton}" AutomationProperties.AutomationId="CheckNow" ToolTip="{Binding CheckActionHelp}" AutomationProperties.Name="{Binding CheckActionLabel}">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" Margin="0,2,8,0"/><TextBlock Text="{Binding CheckActionLabel}"/></StackPanel>
                    </Button>
                    <Button Content="{loc:Loc Cancel}" Command="{Binding CancelCaptureCommand}" Visibility="{Binding IsBusy, Converter={StaticResource BoolVisibility}}"/>
                </WrapPanel>
            </WrapPanel>
            <WrapPanel Grid.Row="1" Margin="0,0,0,12">
                <TextBlock Text="{Binding ScopeLabel}" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}" Margin="0,0,12,8" AutomationProperties.AutomationId="ScopeLabel"/>
                <Button x:Name="ChangeScopeButton" Content="{loc:Loc ChangeScope}" Command="{Binding ChangeScopeCommand}" Margin="0,0,8,8" AutomationProperties.AutomationId="ChangeScope"/>
                <Button Command="{Binding CaptureAsAdministratorCommand}" Visibility="{Binding MachineScope, Converter={StaticResource BoolVisibility}}" Margin="0,0,0,8"
                        MaxWidth="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=WrapPanel}}"
                        ToolTip="{loc:Loc ConsentHelp}" AutomationProperties.AutomationId="CheckAsAdministrator" AutomationProperties.Name="{loc:Loc AdminCheck}">
                    <DockPanel><TextBlock DockPanel.Dock="Left" Text="&#xEA18;" FontFamily="Segoe MDL2 Assets" Margin="0,2,8,0"/><TextBlock Text="{loc:Loc AdminCheck}"/></DockPanel>
                </Button>
            </WrapPanel>
            <Expander Grid.Row="2" Header="{loc:Loc Comparison}" IsExpanded="{Binding ComparisonPickerExpanded}" Margin="0,0,0,12" AutomationProperties.AutomationId="ComparisonOptions">
                <StackPanel IsEnabled="{Binding IsIdle}" Margin="0,12,0,0">
                    <UniformGrid Columns="2" SizeChanged="ResponsiveColumnsChanged">
                        <StackPanel Margin="0,0,16,0">
                            <StackPanel Visibility="{Binding Advanced, Converter={StaticResource BoolVisibility}}" Margin="0,0,0,8">
                                <Label Content="{loc:Loc BeforeDate}" Target="{Binding ElementName=BeforeDayPicker}"/>
                                <ComboBox x:Name="BeforeDayPicker" ItemsSource="{Binding SnapshotDates}" SelectedItem="{Binding BeforeDate, Mode=OneWay}" SelectionChanged="BeforeDaySelected"
                                          ItemTemplate="{StaticResource SnapshotDayTemplate}" ItemContainerStyle="{StaticResource SnapshotDayStyle}" IsEditable="False"
                                          MaxDropDownHeight="320" AutomationProperties.Name="{loc:Loc BeforeDate}" AutomationProperties.AutomationId="BeforeDate"/>
                            </StackPanel>
                            <Label Content="{loc:Loc EarlierSnapshot}" Target="{Binding ElementName=BeforeSnapshotPicker}"/>
                            <ComboBox x:Name="BeforeSnapshotPicker" ItemsSource="{Binding BeforeSnapshotChoices}" SelectedItem="{Binding CompareFrom}" ItemTemplate="{StaticResource SnapshotChoiceTemplate}"
                                      IsEditable="False" IsSynchronizedWithCurrentItem="False" MinHeight="44" MaxDropDownHeight="420"
                                      ItemContainerStyle="{StaticResource SnapshotChoiceStyle}" AutomationProperties.Name="{loc:Loc EarlierSnapshot}" AutomationProperties.AutomationId="BeforeSnapshot" MinWidth="0"/>
                            <WrapPanel Margin="0,8,0,0">
                                <Button Content="{loc:Loc Baseline}" Command="{Binding SelectBaselineCommand}" ToolTip="{loc:Loc Baseline}" Margin="0,0,8,0" FontSize="{DynamicResource AppFont14}" AutomationProperties.Name="{loc:Loc Baseline}"/>
                                <Button Content="&#xE711;" FontFamily="Segoe MDL2 Assets" Width="44" Height="44" Padding="6" Margin="0"
                                        Command="{Binding CurrentStateOnlyCommand}" ToolTip="{loc:Loc CurrentState}" AutomationProperties.Name="{loc:Loc CurrentState}"/>
                            </WrapPanel>
                            <TextBlock Text="{Binding BeforeSelectionSummary}" FontSize="{DynamicResource AppFont14}" Margin="0,6,0,0"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="{loc:Loc After}" FontWeight="SemiBold" Margin="0,0,0,5"/>
                            <WrapPanel Margin="0,0,0,8">
                                <RadioButton Content="{loc:Loc Today}" GroupName="ComparisonTarget" IsChecked="{Binding CompareWithToday}" AutomationProperties.AutomationId="CompareToday"/>
                                <RadioButton Content="{loc:Loc SavedSnapshot}" GroupName="ComparisonTarget" IsChecked="{Binding CompareSavedSnapshots}" AutomationProperties.AutomationId="CompareSaved"/>
                            </WrapPanel>
                            <StackPanel Visibility="{Binding CompareSavedSnapshots, Converter={StaticResource BoolVisibility}}">
                                <StackPanel Visibility="{Binding Advanced, Converter={StaticResource BoolVisibility}}" Margin="0,0,0,8">
                                    <Label Content="{loc:Loc AfterDate}" Target="{Binding ElementName=AfterDayPicker}"/>
                                    <ComboBox x:Name="AfterDayPicker" ItemsSource="{Binding SnapshotDates}" SelectedItem="{Binding AfterDate, Mode=OneWay}" SelectionChanged="AfterDaySelected"
                                              ItemTemplate="{StaticResource SnapshotDayTemplate}" ItemContainerStyle="{StaticResource SnapshotDayStyle}" IsEditable="False"
                                              MaxDropDownHeight="320" AutomationProperties.Name="{loc:Loc AfterDate}" AutomationProperties.AutomationId="AfterDate"/>
                                </StackPanel>
                                <Label Content="{loc:Loc LaterSnapshot}" Target="{Binding ElementName=AfterSnapshotPicker}"/>
                                <ComboBox x:Name="AfterSnapshotPicker" ItemsSource="{Binding AfterSnapshotChoices}" SelectedItem="{Binding CompareTo}" ItemTemplate="{StaticResource SnapshotChoiceTemplate}"
                                          IsEditable="False" IsSynchronizedWithCurrentItem="False" MinHeight="44" MaxDropDownHeight="420"
                                          ItemContainerStyle="{StaticResource SnapshotChoiceStyle}" AutomationProperties.Name="{loc:Loc LaterSnapshot}" AutomationProperties.AutomationId="AfterSnapshot" MinWidth="0"/>
                            </StackPanel>
                            <TextBlock Text="{Binding AfterSelectionSummary}" FontSize="{DynamicResource AppFont14}" Margin="0,6,0,0"/>
                        </StackPanel>
                    </UniformGrid>
                    <TextBlock x:Name="SelectionIssueText" Text="{Binding ComparisonSelectionIssue}" Foreground="{DynamicResource ReviewBrush}" FontWeight="SemiBold" Margin="0,8,0,0"
                               AutomationProperties.LiveSetting="Polite" AutomationProperties.AutomationId="ComparisonSelectionIssue"/>
                </StackPanel>
            </Expander>
            <ProgressBar Grid.Row="3" Height="3" IsIndeterminate="True" Visibility="{Binding IsBusy, Converter={StaticResource BoolVisibility}}" Margin="0,0,0,15" AutomationProperties.Name="{loc:Loc CheckNow}"/>
            <ScrollViewer x:Name="ReviewContent" Grid.Row="4" VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Disabled" Style="{StaticResource ReviewPage}" Focusable="False">
                <StackPanel>
                    <TextBlock x:Name="ReviewHeading" Text="{Binding Headline}" FontSize="{DynamicResource AppFont24}" FontWeight="SemiBold" Margin="0,6,0,6" AutomationProperties.HeadingLevel="Level1" Focusable="True" KeyboardNavigation.IsTabStop="False"/>
                    <TextBlock Text="{Binding Subtitle}" Foreground="{DynamicResource MutedBrush}" FontSize="{DynamicResource AppFont14}" Margin="0,0,0,12"/>
                    <StackPanel Visibility="{Binding IsFirstRun, Converter={StaticResource BoolVisibility}}" Margin="0,14,0,28">
                        <TextBlock Text="{loc:Loc FirstBaseline}" FontSize="{DynamicResource AppFont19}" FontWeight="SemiBold" Margin="0,0,0,10" AutomationProperties.HeadingLevel="Level2"/>
                        <TextBlock Text="{loc:Loc PrivacyIntro}" MaxWidth="650" HorizontalAlignment="Left" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,14"/>
                        <TextBlock Text="{loc:Loc BaselineIntro}" MaxWidth="650" HorizontalAlignment="Left" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,20"/>
                        <Button Content="{loc:Loc CollectionSources}" Command="{Binding NavigateCommand}" CommandParameter="Sources" HorizontalAlignment="Left"/>
                    </StackPanel>
                    <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,1" Padding="0,10" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="{Binding Coverage}" FontWeight="SemiBold"/>
                            <Expander Header="{loc:Loc CoverageDetails}" Margin="0,6,0,0" AutomationProperties.AutomationId="CoverageDetails">
                                <StackPanel>
                                    <TextBlock Text="{Binding UnchangedSummary}" Foreground="{DynamicResource MutedBrush}" FontSize="{DynamicResource AppFont14}" Margin="0,5,0,0"/>
                                    <TextBlock Text="{Binding BaselineText}" Foreground="{DynamicResource MutedBrush}" FontSize="{DynamicResource AppFont14}" Margin="0,5,0,0"/>
                                </StackPanel>
                            </Expander>
                            <Expander Header="{Binding GapHeading}" Visibility="{Binding HasGaps, Converter={StaticResource BoolVisibility}}" Margin="0,10,0,0">
                                <ItemsControl ItemsSource="{Binding Gaps}" AutomationProperties.Name="{Binding GapHeading}"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" Margin="0,6,0,0"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                            </Expander>
                        </StackPanel>
                    </Border>
                    <TextBlock Text="{loc:Loc BaselineReady}" FontSize="{DynamicResource AppFont18}" FontWeight="SemiBold" Visibility="{Binding IsBaselineOnly, Converter={StaticResource BoolVisibility}}" Margin="0,0,0,14" AutomationProperties.HeadingLevel="Level2"/>
                    <StackPanel Visibility="{Binding HasComparison, Converter={StaticResource BoolVisibility}}">
                        <WrapPanel Margin="0,0,0,12">
                            <StackPanel Margin="0,0,8,6"><Label Content="{loc:Loc Category}" Target="{Binding ElementName=CategoryPicker}" FontSize="{DynamicResource AppFont14}"/><ComboBox x:Name="CategoryPicker" ItemsSource="{Binding CategoryFilters}" SelectedItem="{Binding CategoryFilter}" Width="180" AutomationProperties.Name="{loc:Loc Category}"/></StackPanel>
                            <StackPanel Margin="0,0,8,6"><Label Content="{loc:Loc SearchChanges}" Target="{Binding ElementName=ChangesSearch}" FontSize="{DynamicResource AppFont14}"/><TextBox x:Name="ChangesSearch" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Width="240" ToolTip="{loc:Loc SearchChanges}" AutomationProperties.Name="{loc:Loc SearchChanges}"/></StackPanel>
                            <Button Content="{loc:Loc ClearFilters}" Command="{Binding ClearFiltersCommand}" Margin="0,0,0,6" VerticalAlignment="Bottom"/>
                        </WrapPanel>
                        <TextBlock Text="{loc:Loc ReviewFirst}" Foreground="{DynamicResource TextBrush}" FontSize="{DynamicResource AppFont16}" FontWeight="Bold" Margin="0,0,0,12" AutomationProperties.HeadingLevel="Level2"/>
                        <ItemsControl ItemsSource="{Binding ReviewItems}" ItemTemplate="{StaticResource ChangeTemplate}" ItemContainerStyle="{StaticResource ChangeItemContainerStyle}" AutomationProperties.Name="{loc:Loc ReviewFirst}"/>
                        <Button Content="{loc:Loc ViewAll}" Command="{Binding ShowAllCommand}" Visibility="{Binding HasMoreReviews, Converter={StaticResource BoolVisibility}}" HorizontalAlignment="Left" Margin="0,0,0,14"/>
                        <TextBlock Text="{loc:Loc NoReviewsHelp}" Visibility="{Binding HasNoReviews, Converter={StaticResource BoolVisibility}}" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,20"/>
                        <Expander Margin="0,0,0,16" Header="{Binding RoutineHeading}" AutomationProperties.Name="{Binding RoutineHeading}" AutomationProperties.AutomationId="RoutineGroup">
                            <ItemsControl ItemsSource="{Binding RoutineItems}" ItemTemplate="{StaticResource ChangeTemplate}" ItemContainerStyle="{StaticResource ChangeItemContainerStyle}" Margin="0,12,0,0" AutomationProperties.Name="{Binding RoutineHeading}"/>
                        </Expander>
                        <Expander Margin="0,0,0,16" Header="{Binding OtherHeading}" AutomationProperties.Name="{Binding OtherHeading}" AutomationProperties.AutomationId="OtherGroup">
                            <ItemsControl ItemsSource="{Binding OtherItems}" ItemTemplate="{StaticResource ChangeTemplate}" ItemContainerStyle="{StaticResource ChangeItemContainerStyle}" Margin="0,12,0,0" AutomationProperties.Name="{Binding OtherHeading}"/>
                        </Expander>
                    </StackPanel>
                    <Expander Header="{loc:Loc Inventory}" Visibility="{Binding HasSnapshot, Converter={StaticResource BoolVisibility}}" Margin="0,10,0,16">
                        <ListBox ItemsSource="{Binding Inventory}" MaxHeight="320" ScrollViewer.HorizontalScrollBarVisibility="Disabled" BorderThickness="0" Background="{DynamicResource SurfaceBrush}" Margin="0,12,0,0" AutomationProperties.Name="{loc:Loc Inventory}">
                            <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" Margin="6"/></DataTemplate></ListBox.ItemTemplate>
                        </ListBox>
                    </Expander>
                </StackPanel>
            </ScrollViewer>
            <Grid x:Name="HistoryContent" Grid.Row="4" Style="{StaticResource HistoryPage}" IsEnabled="{Binding IsIdle}">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <TextBlock x:Name="HistoryHeading" Text="{loc:Loc SavedSnapshots}" FontSize="{DynamicResource AppFont24}" FontWeight="SemiBold" Margin="0,8,0,20" AutomationProperties.HeadingLevel="Level1" Focusable="True" KeyboardNavigation.IsTabStop="False"/>
                <ListView Grid.Row="2" ItemsSource="{Binding Snapshots}" SelectedItem="{Binding SelectedSnapshot}" MaxHeight="420" MinHeight="160" AutomationProperties.AutomationId="SnapshotList" AutomationProperties.Name="{loc:Loc SavedSnapshots}">
                    <ListView.ItemContainerStyle><Style TargetType="ListViewItem" BasedOn="{StaticResource {x:Type ListViewItem}}">
                        <Setter Property="AutomationProperties.Name"><Setter.Value><MultiBinding Converter="{StaticResource SnapshotText}" ConverterParameter="Compact"><Binding/><Binding Path="DataContext.Texts" RelativeSource="{RelativeSource AncestorType=Window}"/><Binding Path="DataContext.Texts.Revision" RelativeSource="{RelativeSource AncestorType=Window}"/></MultiBinding></Setter.Value></Setter>
                    </Style></ListView.ItemContainerStyle>
                    <ListView.View><GridView>
                        <GridViewColumn DisplayMemberBinding="{Binding CapturedAt, StringFormat=g}" Width="180"><GridViewColumn.Header><TextBlock Text="{loc:Loc Captured}"/></GridViewColumn.Header></GridViewColumn>
                        <GridViewColumn Width="240"><GridViewColumn.Header><TextBlock Text="{loc:Loc ScopeAccess}"/></GridViewColumn.Header><GridViewColumn.CellTemplate><DataTemplate><TextBlock><TextBlock.Text><MultiBinding Converter="{StaticResource SnapshotText}" ConverterParameter="Context"><Binding/><Binding Path="DataContext.Texts" RelativeSource="{RelativeSource AncestorType=Window}"/><Binding Path="DataContext.Texts.Revision" RelativeSource="{RelativeSource AncestorType=Window}"/></MultiBinding></TextBlock.Text></TextBlock></DataTemplate></GridViewColumn.CellTemplate></GridViewColumn>
                        <GridViewColumn DisplayMemberBinding="{Binding Label}" Width="180"><GridViewColumn.Header><TextBlock Text="{loc:Loc Checkpoint}"/></GridViewColumn.Header></GridViewColumn>
                        <GridViewColumn DisplayMemberBinding="{Binding ItemCount}" Width="90"><GridViewColumn.Header><TextBlock Text="{loc:Loc Records}"/></GridViewColumn.Header></GridViewColumn>
                        <GridViewColumn DisplayMemberBinding="{Binding CompleteSources}" Width="150"><GridViewColumn.Header><TextBlock Text="{loc:Loc CompleteSources}"/></GridViewColumn.Header></GridViewColumn>
                    </GridView></ListView.View>
                </ListView>
                <StackPanel Grid.Row="3" Margin="0,18,0,0">
                    <Label Content="{loc:Loc CheckpointName}" Target="{Binding ElementName=CheckpointNameInput}"/>
                    <WrapPanel Margin="0,0,0,10">
                        <TextBox x:Name="CheckpointNameInput" Text="{Binding CheckpointName, UpdateSourceTrigger=PropertyChanged}" Width="290" Margin="0,0,8,0" MaxLength="120" AutomationProperties.Name="{loc:Loc CheckpointName}"/>
                        <Button Content="{loc:Loc NameCheckpoint}" Command="{Binding NameCheckpointCommand}"/>
                    </WrapPanel>
                    <WrapPanel>
                        <Button Content="{loc:Loc ViewSelected}" Command="{Binding ViewSnapshotCommand}"/>
                        <Button Content="{loc:Loc UseBaseline}" Command="{Binding UseBaselineCommand}"/>
                        <Button Content="{loc:Loc DeleteSelected}" Command="{Binding DeleteSnapshotCommand}"/>
                    </WrapPanel>
                </StackPanel>
            </Grid>
            <ScrollViewer x:Name="SourcesContent" Grid.Row="4" Style="{StaticResource SourcesPage}" VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                <StackPanel IsEnabled="{Binding IsIdle}">
                    <TextBlock x:Name="SourcesHeading" Text="{loc:Loc CollectionSources}" FontSize="{DynamicResource AppFont24}" FontWeight="SemiBold" Margin="0,8,0,10" AutomationProperties.HeadingLevel="Level1" Focusable="True" KeyboardNavigation.IsTabStop="False"/>
                    <TextBlock Text="{loc:Loc SourcesIntro}" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,22"/>
                    <ItemsControl ItemsSource="{Binding Sources}" AutomationProperties.Name="{loc:Loc CollectionSources}">
                        <ItemsControl.ItemContainerStyle><Style TargetType="ContentPresenter"><Setter Property="AutomationProperties.Name" Value="{Binding Name}"/></Style></ItemsControl.ItemContainerStyle>
                        <ItemsControl.ItemTemplate><DataTemplate>
                            <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1" Padding="0,12">
                                <StackPanel>
                                    <StackPanel>
                                        <CheckBox Content="{Binding Name}" IsChecked="{Binding Enabled}" IsEnabled="{Binding Available}" FontWeight="SemiBold"
                                                  AutomationProperties.Name="{Binding Name}" AutomationProperties.HelpText="{Binding AccessibilityDescription}" AutomationProperties.ItemStatus="{Binding StatusDisplay}"
                                                  AutomationProperties.AutomationId="{Binding Category, StringFormat=Source{0}}"/>
                                        <TextBlock Text="{Binding Scope}" Margin="20,3,16,0" Foreground="{DynamicResource MutedBrush}" FontSize="{DynamicResource AppFont14}"/>
                                        <TextBlock Text="{Binding DetailDisplay}" Margin="20,5,16,0" Foreground="{DynamicResource ReviewBrush}" FontSize="{DynamicResource AppFont14}"/>
                                    </StackPanel>
                                    <WrapPanel Margin="20,6,0,0">
                                        <TextBlock Text="{Binding StatusDisplay}" FontWeight="SemiBold" Margin="0,5,16,0"/>
                                        <TextBlock Text="{Binding CountDisplay}" Foreground="{DynamicResource MutedBrush}" FontSize="{DynamicResource AppFont14}" Margin="0,5,0,0"/>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate></ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
            <ScrollViewer x:Name="SettingsContent" Grid.Row="4" Style="{StaticResource SettingsPage}" VerticalScrollBarVisibility="Disabled" Focusable="False"
                          HorizontalScrollBarVisibility="Disabled" AutomationProperties.AutomationId="SettingsContent">
                <StackPanel IsEnabled="{Binding IsIdle}">
                    <TextBlock x:Name="SettingsHeading" Text="{loc:Loc SettingsPrivacy}" FontSize="{DynamicResource AppFont24}" FontWeight="SemiBold" Margin="0,8,0,24" AutomationProperties.HeadingLevel="Level1" Focusable="True" KeyboardNavigation.IsTabStop="False"/>

                    <TextBlock Text="{loc:Loc SettingsLanguageHeading}" FontSize="{DynamicResource AppFont19}" FontWeight="SemiBold" Margin="0,0,0,10" AutomationProperties.HeadingLevel="Level2"/>
                    <Label Content="{loc:Loc Language}" Target="{Binding ElementName=LanguagePicker}" FontSize="{DynamicResource AppFont14}"/>
                    <ComboBox x:Name="LanguagePicker" ItemsSource="{Binding Languages}" SelectedItem="{Binding SelectedLanguage}" IsEnabled="{Binding IsIdle}"
                              FlowDirection="LeftToRight" HorizontalAlignment="Left" MinWidth="260" AutomationProperties.AutomationId="LanguagePicker" AutomationProperties.Name="{loc:Loc Language}" Margin="0,0,0,28" MaxDropDownHeight="420">
                        <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Display}" TextWrapping="Wrap" MaxWidth="240" FontSize="{DynamicResource AppFont14}"/></DataTemplate></ComboBox.ItemTemplate>
                        <ComboBox.ItemContainerStyle><Style TargetType="ComboBoxItem" BasedOn="{StaticResource {x:Type ComboBoxItem}}"><Setter Property="AutomationProperties.Name" Value="{Binding Display}"/></Style></ComboBox.ItemContainerStyle>
                    </ComboBox>

                    <TextBlock Text="{loc:Loc SettingsAppearance}" FontSize="{DynamicResource AppFont19}" FontWeight="SemiBold" Margin="0,0,0,10" AutomationProperties.HeadingLevel="Level2"/>
                    <UniformGrid Columns="2" SizeChanged="ResponsiveColumnsChanged" Margin="0,0,0,16">
                        <StackPanel Margin="0,0,16,0">
                            <Label Content="{loc:Loc Theme}" Target="{Binding ElementName=ThemePicker}" FontSize="{DynamicResource AppFont14}"/>
                            <ComboBox x:Name="ThemePicker" ItemsSource="{Binding Themes}" SelectedValue="{Binding SelectedTheme}" SelectedValuePath="Code"
                                      DisplayMemberPath="Display" ItemContainerStyle="{StaticResource SettingsChoiceStyle}" AutomationProperties.AutomationId="ThemePicker" AutomationProperties.Name="{loc:Loc Theme}"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,16,0">
                            <Label Content="{loc:Loc FontLabel}" Target="{Binding ElementName=FontPicker}" FontSize="{DynamicResource AppFont14}"/>
                            <ComboBox x:Name="FontPicker" ItemsSource="{Binding Fonts}" SelectedItem="{Binding SelectedFont}" AutomationProperties.AutomationId="FontPicker" AutomationProperties.Name="{loc:Loc FontLabel}"/>
                        </StackPanel>
                    </UniformGrid>
                    <StackPanel Margin="0,0,0,20">
                        <Label Content="{loc:Loc TextSize}" Target="{Binding ElementName=AppTextSizePicker}"/>
                        <ComboBox x:Name="AppTextSizePicker" ItemsSource="{Binding TextSizes}" SelectedItem="{Binding SelectedTextSize}"
                                  ItemStringFormat="{}{0}%" MinWidth="130" HorizontalAlignment="Left"
                                  AutomationProperties.Name="{loc:Loc TextSize}" AutomationProperties.AutomationId="AppTextSize">
                            <ComboBox.ItemContainerStyle><Style TargetType="ComboBoxItem" BasedOn="{StaticResource {x:Type ComboBoxItem}}"><Setter Property="AutomationProperties.Name" Value="{Binding StringFormat={}{0}%}"/></Style></ComboBox.ItemContainerStyle>
                        </ComboBox>
                    </StackPanel>
                    <UniformGrid Columns="2" SizeChanged="ResponsiveColumnsChanged" Margin="0,0,0,12">
                        <StackPanel Margin="0,0,16,16">
                            <Label Content="{loc:Loc AppTextColorLabel}" Target="{Binding ElementName=AppTextColorPicker}" FontSize="{DynamicResource AppFont14}"/>
                            <ComboBox x:Name="AppTextColorPicker" ItemsSource="{Binding ButtonTextColors}" SelectedValue="{Binding SelectedAppTextColor}" SelectedValuePath="Code"
                                      ItemTemplate="{StaticResource ColorChoiceTemplate}" ItemContainerStyle="{StaticResource SettingsChoiceStyle}"
                                      AutomationProperties.AutomationId="AppTextColorPicker" AutomationProperties.Name="{loc:Loc AppTextColorLabel}"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,0,16">
                            <Label Content="{loc:Loc LabelColorLabel}" Target="{Binding ElementName=LabelColorPicker}" FontSize="{DynamicResource AppFont14}"/>
                            <ComboBox x:Name="LabelColorPicker" ItemsSource="{Binding ButtonTextColors}" SelectedValue="{Binding SelectedLabelColor}" SelectedValuePath="Code"
                                      ItemTemplate="{StaticResource ColorChoiceTemplate}" ItemContainerStyle="{StaticResource SettingsChoiceStyle}"
                                      AutomationProperties.AutomationId="LabelColorPicker" AutomationProperties.Name="{loc:Loc LabelColorLabel}"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,16,16">
                            <Label Content="{loc:Loc ButtonColorLabel}" Target="{Binding ElementName=ButtonColorPicker}" FontSize="{DynamicResource AppFont14}"/>
                            <ComboBox x:Name="ButtonColorPicker" ItemsSource="{Binding ButtonColors}" SelectedValue="{Binding SelectedButtonColor}" SelectedValuePath="Code"
                                      ItemTemplate="{StaticResource ColorChoiceTemplate}" ItemContainerStyle="{StaticResource SettingsChoiceStyle}"
                                      AutomationProperties.AutomationId="ButtonColorPicker" AutomationProperties.Name="{loc:Loc ButtonColorLabel}"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,0,16">
                            <Label Content="{loc:Loc ButtonTextColorLabel}" Target="{Binding ElementName=ButtonTextColorPicker}" FontSize="{DynamicResource AppFont14}"/>
                            <ComboBox x:Name="ButtonTextColorPicker" ItemsSource="{Binding ButtonTextColors}" SelectedValue="{Binding SelectedButtonTextColor}" SelectedValuePath="Code"
                                      ItemTemplate="{StaticResource ColorChoiceTemplate}" ItemContainerStyle="{StaticResource SettingsChoiceStyle}" AutomationProperties.AutomationId="ButtonTextColorPicker" AutomationProperties.Name="{loc:Loc ButtonTextColorLabel}"/>
                        </StackPanel>
                    </UniformGrid>

                    <TextBlock Text="{loc:Loc SettingsAutomatic}" FontSize="{DynamicResource AppFont19}" FontWeight="SemiBold" Margin="0,0,0,10" AutomationProperties.HeadingLevel="Level2"/>
                    <TextBlock Text="{loc:Loc AutomaticHelp}" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,14"/>
                    <UniformGrid Columns="2" SizeChanged="ResponsiveColumnsChanged" Margin="0,0,0,28">
                        <StackPanel Margin="0,0,16,0">
                            <Label Content="{loc:Loc SnapshotFrequency}" Target="{Binding ElementName=FrequencyPicker}" FontSize="{DynamicResource AppFont14}"/>
                            <ComboBox x:Name="FrequencyPicker" ItemsSource="{Binding ScheduleIntervals}" SelectedValue="{Binding SelectedScheduleInterval}" SelectedValuePath="Code"
                                      DisplayMemberPath="Display" ItemContainerStyle="{StaticResource SettingsChoiceStyle}" AutomationProperties.AutomationId="FrequencyPicker" AutomationProperties.Name="{loc:Loc SnapshotFrequency}"/>
                        </StackPanel>
                        <StackPanel>
                            <Label Content="{loc:Loc DataRetention}" Target="{Binding ElementName=RetentionPicker}" FontSize="{DynamicResource AppFont14}"/>
                            <ComboBox x:Name="RetentionPicker" ItemsSource="{Binding RetentionOptions}" SelectedValue="{Binding SelectedRetention}" SelectedValuePath="Code"
                                      DisplayMemberPath="Display" ItemContainerStyle="{StaticResource SettingsChoiceStyle}" AutomationProperties.AutomationId="RetentionPicker" AutomationProperties.Name="{loc:Loc DataRetention}"/>
                        </StackPanel>
                    </UniformGrid>

                    <TextBlock Text="{loc:Loc SettingsStartup}" FontSize="{DynamicResource AppFont19}" FontWeight="SemiBold" Margin="0,0,0,10" AutomationProperties.HeadingLevel="Level2"/>
                    <CheckBox Content="{loc:Loc StartWithWindows}" IsChecked="{Binding StartWithWindows}" AutomationProperties.AutomationId="StartWithWindows"/>
                    <TextBlock Text="{loc:Loc StartupHelp}" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,28"/>

                    <TextBlock Text="{loc:Loc LocalHistory}" FontSize="{DynamicResource AppFont19}" FontWeight="SemiBold" Margin="0,0,0,10" AutomationProperties.HeadingLevel="Level2"/>
                    <TextBox Text="{Binding DataDirectory, Mode=OneWay}" FlowDirection="LeftToRight" IsReadOnly="True" TextWrapping="Wrap" Margin="0,0,0,10" AutomationProperties.Name="{loc:Loc DataFolder}"/>
                    <TextBlock Text="{Binding StorageText}" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,14"/>
                    <Button Content="{loc:Loc ClearHistory}" Command="{Binding ClearHistoryCommand}" IsEnabled="{Binding IsIdle}" HorizontalAlignment="Left" Margin="0,0,0,28"/>
                    <TextBlock Text="{loc:Loc StoredData}" FontSize="{DynamicResource AppFont19}" FontWeight="SemiBold" Margin="0,0,0,10" AutomationProperties.HeadingLevel="Level2"/>
                    <TextBlock Text="{loc:Loc StorageHelp}" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,22"/>
                    <TextBlock Text="{loc:Loc Sharing}" FontSize="{DynamicResource AppFont19}" FontWeight="SemiBold" Margin="0,0,0,10" AutomationProperties.HeadingLevel="Level2"/>
                    <TextBlock Text="{loc:Loc SharingHelp}" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,22"/>
                    <TextBlock Text="{loc:Loc PriceHelp}" Foreground="{DynamicResource MutedBrush}"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>
        </ScrollViewer>
        <Border Grid.Row="1" Grid.Column="1" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Padding="28,12" Background="{DynamicResource SurfaceBrush}">
            <TextBlock x:Name="StatusText" Text="{Binding Status}" FlowDirection="{Binding Texts.Direction}" Foreground="{DynamicResource TextBrush}" FontSize="{DynamicResource AppFont14}" AutomationProperties.LiveSetting="Polite" AutomationProperties.AutomationId="StatusText"/>
        </Border>
        <Border Grid.Column="1" Grid.RowSpan="2" Background="#60000000" FlowDirection="{Binding Texts.Direction}">
            <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding SelectedChange}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Border.Style>
            <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" Padding="26" Margin="36" CornerRadius="6" KeyboardNavigation.TabNavigation="Cycle">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <DockPanel><Button x:Name="CloseDetailButton" DockPanel.Dock="Right" Content="{loc:Loc Close}" Command="{Binding CloseDetailsCommand}" IsCancel="True" AutomationProperties.AutomationId="CloseChangeDetails"/><TextBlock Text="{Binding SelectedChange.Name}" FontSize="{DynamicResource AppFont22}" FontWeight="SemiBold" AutomationProperties.HeadingLevel="Level1"/></DockPanel>
                    <TextBlock Grid.Row="1" Text="{Binding SelectedChange.Window}" Foreground="{DynamicResource MutedBrush}" Margin="0,12,0,14"/>
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Disabled" Focusable="False" AutomationProperties.Name="{loc:Loc BeforeAfter}" AutomationProperties.AutomationId="ChangeDetails">
                        <StackPanel DataContext="{Binding SelectedChange}" Margin="0,0,12,0">
                            <WrapPanel Margin="0,0,0,12"><TextBlock Text="{Binding Category}" Margin="0,0,16,0"/><TextBlock Text="{Binding Kind}" FontWeight="SemiBold"/></WrapPanel>
                            <TextBlock Text="{Binding Why}" FontSize="{DynamicResource AppFont18}" Margin="0,0,0,16"/>
                            <StackPanel Visibility="{Binding DataContext.Simple, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolVisibility}}">
                                <TextBlock Text="{Binding SimpleSummary}" Style="{StaticResource SimpleSummaryStyle}"/>
                                <ItemsControl ItemsSource="{Binding ChangedFields}" ItemTemplate="{StaticResource DetailRowTemplate}" ItemContainerStyle="{StaticResource DetailItemContainerStyle}" AutomationProperties.Name="{loc:Loc BeforeAfter}"/>
                            </StackPanel>
                            <StackPanel Visibility="{Binding DataContext.Advanced, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolVisibility}}">
                                <TextBlock Text="{loc:Loc AllFields}" FontSize="{DynamicResource AppFont19}" FontWeight="SemiBold" AutomationProperties.HeadingLevel="Level2"/>
                                <ItemsControl ItemsSource="{Binding FieldDetails}" ItemTemplate="{StaticResource DetailRowTemplate}" ItemContainerStyle="{StaticResource DetailItemContainerStyle}" AutomationProperties.Name="{loc:Loc AllFields}"/>
                                <TextBlock Text="{loc:Loc ObservationMetadata}" FontSize="{DynamicResource AppFont19}" FontWeight="SemiBold" Margin="0,16,0,8" AutomationProperties.HeadingLevel="Level2"/>
                                <ItemsControl ItemsSource="{Binding ObservationDetails}" ItemTemplate="{StaticResource DetailRowTemplate}" ItemContainerStyle="{StaticResource DetailItemContainerStyle}" AutomationProperties.Name="{loc:Loc ObservationMetadata}"/>
                                <TextBlock Text="{loc:Loc AdvancedPrivacy}" Margin="0,8,0,12"/>
                            </StackPanel>
                            <TextBlock Text="{Binding HiddenComparison}" Margin="0,8,0,12"/>
                            <TextBlock Text="{loc:Loc Uncertainty}"/>
                        </StackPanel>
                    </ScrollViewer>
                    <WrapPanel Grid.Row="3" Margin="0,18,0,0">
                        <Button Content="{loc:Loc CopyDetails}" Command="{Binding CopyDetailsCommand}" CommandParameter="{Binding SelectedChange}"/>
                        <Button Content="{loc:Loc OpenSettings}" Command="{Binding OpenSettingsCommand}" CommandParameter="{Binding SelectedChange}"/>
                        <Button Content="{Binding SelectedChange.ExpectedAction}" Command="{Binding ToggleExpectedCommand}" CommandParameter="{Binding SelectedChange}"/>
                    </WrapPanel>
                </Grid>
                </ScrollViewer>
            </Border>
        </Border>
        <Border Grid.Column="1" Grid.RowSpan="2" Background="#60000000" FlowDirection="{Binding Texts.Direction}" Visibility="{Binding ChoosingScope, Converter={StaticResource BoolVisibility}}">
            <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" Padding="28"
                    MaxWidth="560" Margin="24" HorizontalAlignment="Center" VerticalAlignment="Center" CornerRadius="6">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                <StackPanel KeyboardNavigation.TabNavigation="Cycle">
                    <TextBlock Text="{loc:Loc ScopeQuestion}" FontSize="{DynamicResource AppFont22}" FontWeight="SemiBold" Margin="0,0,0,24" AutomationProperties.HeadingLevel="Level1"/>
                    <CheckBox x:Name="CurrentUserScopeCheckBox" Content="{loc:Loc UserScope}" IsChecked="{Binding CurrentUserScope}" FontWeight="SemiBold"
                                 AutomationProperties.AutomationId="CurrentUserScope" Margin="0,0,0,6"/>
                    <TextBlock Text="{loc:Loc UserScopeHelp}" Foreground="{DynamicResource MutedBrush}" Margin="22,0,0,20"/>
                    <CheckBox Content="{loc:Loc MachineScope}" IsChecked="{Binding MachineScope}" FontWeight="SemiBold"
                                 AutomationProperties.AutomationId="MachineScope" Margin="0,0,0,6"/>
                    <TextBlock Text="{loc:Loc MachineScopeHelp}" Foreground="{DynamicResource MutedBrush}" Margin="22,0,0,20"/>
                    <TextBlock Text="{loc:Loc ConsentHelp}"
                               Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,24"/>
                        <WrapPanel HorizontalAlignment="Right">
                        <Button Content="{loc:Loc Help}" Command="ApplicationCommands.Help" ToolTip="F1" AutomationProperties.AutomationId="ScopeHelpMe"/>
                        <Button Content="{loc:Loc UseScope}" Command="{Binding ConfirmScopeCommand}" Style="{StaticResource PrimaryButton}"
                            AutomationProperties.AutomationId="ConfirmScope"/>
                        </WrapPanel>
                </StackPanel>
                </ScrollViewer>
            </Border>
        </Border>
    </Grid>
</Window>